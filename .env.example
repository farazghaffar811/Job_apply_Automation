# Copy this file to .env and fill in what you need. Everything is optional.

PORT=4310

# Public address of the app. On Vercel this is filled in automatically from the production domain.
# BASE_URL=https://your-app.vercel.app

# Online storage (required on Vercel, optional locally).
# Vercel's filesystem is read-only, so accounts, companies and resumes are kept in Upstash Redis there.
# In Vercel: Storage -> add "Upstash for Redis" -> connect to this project. These two values are
# then added for you. Without them the app stores everything in data/db.json and uploads/.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# "Sign in with LinkedIn" (OpenID Connect).
# 1. Create an app at https://www.linkedin.com/developers/apps
# 2. Products tab -> request "Sign In with LinkedIn using OpenID Connect"
# 3. Auth tab -> add the redirect URL: http://localhost:4310/auth/linkedin/callback
#    and, for Vercel, https://<your-app>.vercel.app/auth/linkedin/callback
# 4. Paste the Client ID and Client Secret below, then restart the server.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
