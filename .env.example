# Copy this file to .env and fill in what you need. Everything is optional.

PORT=4310

# "Sign in with LinkedIn" (OpenID Connect).
# 1. Create an app at https://www.linkedin.com/developers/apps
# 2. Products tab -> request "Sign In with LinkedIn using OpenID Connect"
# 3. Auth tab -> add this redirect URL: http://localhost:4310/auth/linkedin/callback
# 4. Paste the Client ID and Client Secret below, then restart the server.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
